{
    "compilerOptions": {
      "allowJs": false,
      "emitDecoratorMetadata": true,
      "experimentalDecorators": true,
      "declaration": true,
      "sourceMap": true,
      "skipLibCheck": true, // Required due to type errors in powerbi-visuals-api declarations. Can be removed once the type errors are fixed in powerbi-visuals-api.
      "module": "ESNext",
      "moduleResolution": "bundler",
      "target": "ES2020",
      "lib": [
        "ES2020",
        "dom"
      ],
      "rootDir": "./src",
      "outDir": "./lib"
    },
    "files": [
      "src/index.ts"
    ],
    "include": [
      "src/index.ts"
    ]
  }